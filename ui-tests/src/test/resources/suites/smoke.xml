<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="UI Smoke Suite" parallel="methods" thread-count="2">
    <listeners>
        <listener class-name="com.assignment.common.listeners.TestListener"/>
        <listener class-name="com.assignment.common.listeners.RetryTransformer"/>
    </listeners>
    <test name="SauceDemo - Smoke">
        <groups><run><include name="smoke"/></run></groups>
        <packages><package name="com.assignment.ui.tests"/></packages>
    </test>
</suite>
