<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Regression Suite" parallel="classes" thread-count="3">
    <listeners>
        <listener class-name="com.assignment.common.listeners.TestListener"/>
        <listener class-name="com.assignment.common.listeners.RetryTransformer"/>
    </listeners>
    <test name="Petstore API">
        <groups><run><exclude name="known-defect"/></run></groups>
        <packages><package name="com.assignment.api.tests"/></packages>
    </test>
</suite>
