<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Contract tests that FAIL against the public Petstore: documented findings, not framework bugs. -->
<suite name="API Known Defects Suite">
    <listeners>
        <listener class-name="com.assignment.common.listeners.TestListener"/>
    </listeners>
    <test name="Petstore Spec Compliance">
        <groups><run><include name="known-defect"/></run></groups>
        <packages><package name="com.assignment.api.tests"/></packages>
    </test>
</suite>
